rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos privados de cada usuario (solo el dueño los ve y modifica)
    match /users/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /attempts/{id} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Ranking público (solo primer nombre, grado y puntos)
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
